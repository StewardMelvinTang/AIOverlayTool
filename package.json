{
  "name": "float-ai",
  "version": "0.1.8",
  "description": "Float AI",
  "main": "dist-electron/main.js",
  "author": "Float AI",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:main": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.renderer.json",
    "test:external-navigation": "electron scripts/smoke-external-navigation.js",
    "test:memory-protection": "npm run build:main && node scripts/test-provider-memory-protection.js",
    "test:provider-memory-recovery": "npm run build && node scripts/smoke-provider-memory-recovery.js",
    "test:provider-browser": "npm run build && electron scripts/smoke-provider-browser.js",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "pack": "npm run build && electron-builder --dir",
    "pack:mac": "npm run build && electron-builder --mac --dir && find release -maxdepth 2 -name \"Float AI.app\" -exec codesign --deep --force --sign - {} \\;",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@cloudflare/speedtest": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron-store": "^7.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^42.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.floatai.launcher",
    "productName": "Float AI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "provider-icons/**/*",
      "icon_white.png",
      "icon_256.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "icon_256.png",
      "executableName": "Float AI",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
